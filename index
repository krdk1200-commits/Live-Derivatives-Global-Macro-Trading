        ans = `<b>AI Guru Ji (रिलायंस रिपोर्ट):</b> रिलायंस (CMP ₹2,985) पर मॉर्गन स्टेनली और जेफ़रीज़ दोनों का ओवरवेट टारगेट ₹3,380-₹3,400 है। 2,940 के स्टॉप लॉस के साथ बाय-ऑन-डिप्स रणनीति सबसे सही है।`;
      } else if (q.includes('pcr') || q.includes('option chain')) {
        ans = `<b>AI Guru Ji (ऑप्शन चेन एवं पीसीआर):</b> निफ्टी का लाइव पीसीआर 1.14 है। 22,800 पुट पर 16.2M का विशाल सपोर्ट है। जब तक 22,800 का लेवल नहीं टूटता, तब तक मंदी की पोजीशन बनाने से बचें।`;
      } else {
        ans = `<b>AI Guru Ji:</b> वर्तमान लाइव सेटअप (निफ्टी 22,988, पीसीआर 1.14, यूएस यील्ड 4.28%) बाय-ऑन-डिप्स को सपोर्ट करता है। 22,800 का स्तर मजबूत सपोर्ट है। ऑप्शंस में <b>Bull Put Spread (22,900 / 22,800)</b> सबसे सुरक्षित ट्रेड है।`;

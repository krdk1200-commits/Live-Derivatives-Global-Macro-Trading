    /* ----------------------------------------------------
       WEBSOCKET LIVE CLIENT INTEGRATION (ws://localhost:8765)
    ---------------------------------------------------- */
    let socket = null;
    let wsRetryInterval = null;

    function initWebSocketClient() {
      try {
        socket = new WebSocket('ws://localhost:8765');

        socket.onopen = function() {
          terminalState.isWsConnected = true;
          updateWsBadge(true);
          showToast("Connected to Local Angel One WebSocket Bridge (ws://localhost:8765)");
          clearInterval(wsRetryInterval);
        };

        socket.onmessage = function(event) {
          try {
            const data = JSON.parse(event.data);
            if (data.type === 'LIVE_TICK') {
              if (data.nifty_ltp) {
                applyLivePriceTick(data.nifty_ltp);
              }
              if (data.macro && data.macro.brent) {
                terminalState.brentCrude = data.macro.brent;
                document.getElementById('valBrentLtp').innerHTML = `$${terminalState.brentCrude} <span class="text-xs text-slate-400 font-normal">/bbl</span>`;
              }
            }
          } catch (e) {
            console.error("WS Parse Error", e);
          }
        };

        socket.onerror = function() {
          terminalState.isWsConnected = false;
          updateWsBadge(false);
        };

        socket.onclose = function() {
          terminalState.isWsConnected = false;
          updateWsBadge(false);
          // Try re-connecting silently every 6 seconds
          if (!wsRetryInterval) {
            wsRetryInterval = setInterval(initWebSocketClient, 6000);
          }
        };
      } catch (err) {
        terminalState.isWsConnected = false;
        updateWsBadge(false);
      }
    }

    function toggleWsConnection() {
      if (socket && socket.readyState === WebSocket.OPEN) {
        socket.close();
        showToast("WebSocket disconnected manually");
      } else {
        initWebSocketClient();
        showToast("Attempting WebSocket Connection to ws://localhost:8765...");
      }
    }


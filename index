    /* ----------------------------------------------------
       OPTION CHAIN & PCR MATRIX (±500 POINTS ENGINE)
    ---------------------------------------------------- */
    function renderOptionMatrix() {
      let spot = terminalState.niftyLtp;
      let step = 50;

      if (currentChainIdx === 'SENSEX') {
        spot = terminalState.sensexLtp;
        step = 100;
      } else if (currentChainIdx === 'BANKNIFTY') {
        spot = terminalState.bankNiftyLtp;
        step = 100;
      }

      // Calculate exact ATM strike rounded to nearest step
      const atm = Math.round(spot / step) * step;
      document.getElementById('atmStrikeDisplay').innerText = atm.toLocaleString();
      document.getElementById('matrixSpanText').innerText = `±500 pts (${(atm - 500).toLocaleString()} - ${(atm + 500).toLocaleString()})`;

      const tbody = document.getElementById('optionTableBody');
      tbody.innerHTML = '';

      let totalCE = 0;
      let totalPE = 0;
      let maxCE = 0;
      let maxPE = 0;
      let maxCeStrike = atm;
      let maxPeStrike = atm;

      for (let s = atm - 500; s <= atm + 500; s += step) {
        const isATM = (s === atm);
        const dist = s - atm;

        // Dynamic realistic Open Interest distribution
        let callOi = Math.max(12, Math.round(85 + (dist > 0 ? (dist / 6) : -(dist / 14)) + Math.sin(s * 0.05) * 15));
        let putOi = Math.max(12, Math.round(85 + (dist < 0 ? (-dist / 6) : (dist / 14)) + Math.cos(s * 0.05) * 15));

        // Intrinsic + Premium calculation
        let callLtp = dist < 0 ? (Math.abs(dist) + 42.5) : Math.max(2.1, Math.round(110 * Math.exp(-dist / 220) * 10) / 10);
        let putLtp = dist > 0 ? (dist + 38.0) : Math.max(2.1, Math.round(105 * Math.exp(dist / 220) * 10) / 10);

        let callChg = (Math.sin(s) * 8.5).toFixed(1);
        let putChg = (Math.cos(s) * 10.2).toFixed(1);

        // Strike PCR = Put OI / Call OI
        let strikePcr = (putOi / (callOi || 1)).toFixed(2);

        totalCE += callOi;
        totalPE += putOi;

        if (callOi > maxCE) { maxCE = callOi; maxCeStrike = s; }
        if (putOi > maxPE) { maxPE = putOi; maxPeStrike = s; }

        const tr = document.createElement('tr');
        tr.className = isATM 
          ? 'bg-cyan-950/60 border-y-2 border-cyan-400 font-bold' 
          : 'hover:bg-slate-800/40 transition-colors';

        let pcrColorClass = 'text-slate-300';
        if (strikePcr >= 1.25) pcrColorClass = 'text-emerald-400 font-bold';
        else if (strikePcr <= 0.80) pcrColorClass = 'text-red-400 font-bold';

        tr.innerHTML = `
          <!-- CALLS (CE) -->
          <td class="py-1.5 px-2 text-right text-slate-300 ${callOi === maxCE ? 'text-amber-300 font-bold' : ''}">${callOi.toFixed(1)}L</td>
          <td class="py-1.5 px-2 text-right ${parseFloat(callChg) >= 0 ? 'text-emerald-400' : 'text-red-400'}">${parseFloat(callChg) >= 0 ? '+' : ''}${callChg}%</td>
          <td class="py-1.5 px-2 text-right font-semibold text-slate-100 border-r border-slate-800">₹${callLtp.toFixed(1)}</td>

          <!-- STRIKE -->
          <td class="py-1.5 px-3 text-center ${isATM ? 'bg-cyan-900/80 text-cyan-300 text-sm font-extrabold shadow' : 'bg-slate-900/70 text-white font-semibold'} border-r border-slate-800">
            ${s.toLocaleString()} ${isATM ? '<span class="text-[9px] uppercase px-1 py-0.2 rounded bg-amber-500/20 text-amber-300 ml-1">ATM</span>' : ''}
          </td>

          <!-- STRIKE PCR -->
          <td class="py-1.5 px-2 text-center border-r border-slate-800 ${pcrColorClass}">
            ${strikePcr}
          </td>

          <!-- PUTS (PE) -->
          <td class="py-1.5 px-2 text-left font-semibold text-slate-100">₹${putLtp.toFixed(1)}</td>
          <td class="py-1.5 px-2 text-left ${parseFloat(putChg) >= 0 ? 'text-emerald-400' : 'text-red-400'}">${parseFloat(putChg) >= 0 ? '+' : ''}${putChg}%</td>
          <td class="py-1.5 px-2 text-left text-slate-300 ${putOi === maxPE ? 'text-emerald-300 font-bold' : ''}">${putOi.toFixed(1)}L</td>
        `;

        tbody.appendChild(tr);
      }

      // Aggregate PCR
      const aggregatePcr = (totalPE / (totalCE || 1)).toFixed(2);
      document.getElementById('sumCallOi').innerText = (totalCE * 100000).toLocaleString();
      document.getElementById('sumPutOi').innerText = (totalPE * 100000).toLocaleString();
      document.getElementById('aggregatePcrDisplay').innerText = aggregatePcr;
      document.getElementById('maxCallStrike').innerText = maxCeStrike.toLocaleString();
      document.getElementById('maxPutStrike').innerText = maxPeStrike.toLocaleString();
      document.getElementById('maxPainDisplay').innerText = atm.toLocaleString();

      if (currentChainIdx === 'NIFTY') {
        document.getElementById('niftyAggPcr').innerText = aggregatePcr;
      } else if (currentChainIdx === 'SENSEX') {
        document.getElementById('sensexAggPcr').innerText = aggregatePcr;
      }
    }


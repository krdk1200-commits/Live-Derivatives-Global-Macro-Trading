      terminalState.niftyLtp = parseFloat(newNiftyPrice.toFixed(2));

      const el = document.getElementById('valNiftyLtp');
      el.innerText = terminalState.niftyLtp.toLocaleString('en-IN', { minimumFractionDigits: 2 });
